<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Thank You - Furious Beauty</title>
<style>
html, body { margin:0; padding:0; font-family:Arial,sans-serif; min-height:100vh; display:flex; flex-direction:column; }
main { flex:1; display:flex; justify-content:center; align-items:center; padding:20px; background:#f9f9f9; text-align:center; }

header { background:#111; color:white; padding:30px; display:flex; justify-content:space-between; align-items:center; position:sticky; top:0; z-index:100; }
header h1 { font-family:'Playfair Display', serif; font-size:48px; margin:0; }
nav a { color:white; margin-left:15px; text-decoration:none; font-weight:bold; }
nav a:hover { color:rgb(238,39,99); }

footer { background:#111; color:white; text-align:center; padding:10px 20px; }
footer a { color:white; margin:0 10px; text-decoration:none; font-weight:bold; }
footer a:hover { color:rgb(238,39,99); }

.thankyou-box { background:#fff; padding:40px; border-radius:10px; box-shadow:0 8px 20px rgba(0,0,0,0.2); max-width:500px; width:100%; }
.thankyou-box h2 { color:#e91176; margin-bottom:20px; }
.thankyou-box p { font-size:18px; margin-bottom:10px; }
</style>
</head>
<body>

<header>
  <h1>Furious Beauty</h1>
  <nav>
    <a href="index.html">Home</a>
    <a href="index.html#shop">Shop</a>
    <a href="about.html">About</a>
    <a href="contact.html">Contact</a>
  </nav>
</header>

<main>
  <div class="thankyou-box">
    <h2>Thank You for Your Order!</h2>
    <p id="buyer-name">Dear Customer,</p>
    <p id="order-number">Your order number: #000</p>
    <p>We will process your order shortly.</p>
    <a href="index.html" style="color:#e91176; font-weight:bold; text-decoration:none;">Continue Shopping</a>
  </div>
</main>

<footer>
  <p>&copy; 2025 Furious Beauty. All rights reserved.</p>
  <p>
    <a href="https://www.instagram.com/furiousbeautyy" target="_blank">Instagram</a>
    <a href="https://www.tiktok.com/@furious.beautyy" target="_blank">TikTok</a>
  </p>
</footer>

<script>
window.addEventListener('DOMContentLoaded', () => {
    const buyerName = localStorage.getItem('lastOrderName') || 'Customer';
    const orderNumber = localStorage.getItem('lastOrderNumberDisplay') || '000';
    document.getElementById('buyer-name').textContent = `Dear ${buyerName},`;
    document.getElementById('order-number').textContent = `Your order number: #${orderNumber}`;
});
</script>

</body>
</html>
